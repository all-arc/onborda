{
  "name": "okido",
  "version": "1.0.0",
  "description": "Product tour library for Next.js",
  "type": "module",
  "license": "MIT",
  "author": "Matt Litherland",
  "homepage": "https://github.com/all-arc/okido#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/all-arc/okido.git"
  },
  "keywords": [
    "react-onboarding",
    "react-okido",
    "onboarding",
    "okido",
    "wizard",
    "react",
    "product-tour",
    "tour",
    "demo",
    "product-demo"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./okido": {
      "types": "./dist/Okido.d.ts",
      "import": "./dist/Okido.js"
    },
    "./context": {
      "types": "./dist/OkidoContext.d.ts",
      "import": "./dist/OkidoContext.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "check:deps": "node node_modules/knip/bin/knip.js --no-progress",
    "knip": "node node_modules/knip/bin/knip.js --no-progress",
    "test": "vitest run --environment jsdom --pool forks",
    "start": "npm run build && node dist/index.js"
  },
  "peerDependencies": {
    "@radix-ui/react-portal": ">=1.1.1",
    "framer-motion": ">=11",
    "next": ">=13",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^29.1.1",
    "knip": "^6.16.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  },
  "packageManager": "pnpm@9.15.0+sha512.76e2379760a4328ec4415815bcd6628dee727af3779aaa4c914e3944156c4299921a89f976381ee107d41f12cfa4b66681ca9c718f0668fa0831ed4c6d8ba56c",
  "dependencies": {
    "@floating-ui/react": "^0.27.19"
  }
}
